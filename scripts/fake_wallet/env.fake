# Valores para correr el stack local contra el broker y la wallet falsos (perfil "fake").
# Agregarlos al final de backend/.env (las líneas posteriores pisan a las anteriores).
# No son secretos: sólo existen en el RabbitMQ local (rabbitmq/definitions.json).
BROKER_HOST=rabbitmq
BROKER_PORT=5672
BROKER_USE_SSL=false
BROKER_VHOST=energy
BROKER_USER=observer
BROKER_PASSWORD=local-observer
BROKER_QUEUE=observer.local.q
CITY_BROKER_PASSWORD=local-tal
WALLET_BASE_URL=http://fake-wallet:8080/v1
WALLET_API_KEY=fake-key-tal
WALLET_ENABLED=true
