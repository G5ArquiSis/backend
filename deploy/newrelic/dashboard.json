          }
        }
      ]
    },
    {
      "name": "Infraestructura",
      "description": "Contenedores en la EC2",
      "widgets": [
        {
          "title": "Memoria por contenedor (MB)",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8591548
                ],
                "query": "SELECT average(memoryUsageBytes)/1e6 FROM ContainerSample FACET name TIMESERIES SINCE 1 day ago"
              }
            ],
            "facet": {
              "showOtherSeries": false
            },
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Reinicios y límite de memoria",
          "layout": {
            "column": 7,
            "row": 1,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8591548
                ],
                "query": "SELECT latest(restartCount) AS 'Reinicios', max(memoryUsageBytes)/1e6 AS 'Máx MB', latest(memorySizeLimitBytes)/1e6 AS 'Límite MB' FROM ContainerSample FACET name SINCE 1 day ago"
              }
            ],
            "facet": {
              "showOtherSeries": false
            },
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Host: memoria y swap (MB)",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 12,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8591548
                ],
                "query": "SELECT average(memoryUsedBytes)/1e6 AS 'Usada', average(swapUsedBytes)/1e6 AS 'Swap' FROM SystemSample TIMESERIES SINCE 1 day ago"
              }
            ],
            "facet": {
              "showOtherSeries": false
            },
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        }
      ]
    }
  ],
  "variables": []
}
