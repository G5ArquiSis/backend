# Copiar a .env y completar. NUNCA subir .env al repo (descuento de 5 décimas).
# Toda variable nueva se documenta acá: la persona de deploy arma el .env de producción desde este archivo.

# --- Broker RabbitMQ del curso: credenciales del observer (demand-set de la E0) ---
# El puerto 5671 es AMQPS: la URL debe usar esquema amqps:// y handshake TLS.
BROKER_HOST=broker.iic2173.org
BROKER_PORT=5671
BROKER_USER=
BROKER_PASSWORD=
BROKER_VHOST=/
BROKER_QUEUE=observer.X.q
# El puerto 5671 usa TLS; solo se apaga para un broker local sin TLS.
BROKER_USE_SSL=true

# --- Broker: credenciales de la ciudad (E1) ---
# El usuario no se configura: es city.{CITY_CODE}, la misma cadena que el user_id.
# Vacía, connector no consume la cola de la ciudad y sigue atendiendo solo la E0.
CITY_BROKER_PASSWORD=
# Cola de la ciudad. Vacía, se usa city.{CITY_CODE}.q, como la nombra el curso.
CITY_QUEUE=
# Destino de lo que se publica a la central: exchange del curso y routing key de la central.
CENTRAL_EXCHANGE=energy.x
CENTRAL_ROUTING_KEY=central
# Cada cuántos segundos connector le pide a master lo pendiente por publicar.
OUTBOX_POLL_SECONDS=5

# --- Postgres ---
POSTGRES_USER=energyshark
POSTGRES_PASSWORD=changeme
POSTGRES_DB=energyshark

# Consumido por master. El host "postgres" es el nombre del servicio en la red Docker.
DATABASE_URL=postgresql+asyncpg://energyshark:changeme@postgres:5432/energyshark

# --- Contrato HTTP connector -> master ---
# "master" es un alias de red compartido por master-1 y master-2: el DNS interno
# de Docker reparte las conexiones entre ambas réplicas (round-robin).
MASTER_EVENTS_URL=http://master:8000/events
MASTER_HTTP_TIMEOUT_SECONDS=10

# --- Ciclo de negociación (E1) ---
# Código de la ciudad asignada. Lo usan master (cityId de lo que emitimos) y connector
# (usuario del broker, cola y user_id).
CITY_CODE=TAL
# Duración del periodo de cierre, en que la central acepta el negotiation-report.
REPORT_CLOSING_SECONDS=300
# Margen tras la apertura de ese periodo, por la diferencia entre relojes.
REPORT_MARGIN_SECONDS=15
# Plazo de confirmación y de pago de una negociación, y envíos máximos por operación.
NEGOTIATION_TIMEOUT_SECONDS=30
NEGOTIATION_MAX_ATTEMPTS=3
# Tiempo tras el cual un mensaje retirado de la outbox y no confirmado se vuelve a ofrecer.
OUTBOX_REDELIVERY_SECONDS=60
# Si la central habla de un ciclo sin mandar su status-statement, master lo pide (request):
# espera este margen, separa los pedidos por el intervalo y no pide más veces que el tope.
STATEMENT_REQUEST_GRACE_SECONDS=30
STATEMENT_REQUEST_INTERVAL_SECONDS=120
STATEMENT_REQUEST_MAX_ATTEMPTS=3

# --- Mercado y wallet (E2) ---
# Flags por entorno. Cada merge a main despliega solo a producción, así que el código
# nuevo entra apagado y se enciende acá (en el .env de la EC2) cuando está probado.
# MARKET_ENABLED lo leen master y connector (cola market.{CITY_CODE} y exchange market);
# WALLET_ENABLED, master (llamadas a la wallet).
MARKET_ENABLED=false
WALLET_ENABLED=false
# URL base de la wallet de la central, con el /v1 (Referencia API v3 § Direcciones).
WALLET_BASE_URL=
# API key de la ciudad para la wallet (header X-Api-Key). Es un SECRETO como el .env:
# nunca al repo; si se filtra, pedir rotación al equipo docente de inmediato.
WALLET_API_KEY=
# Cada cuántos segundos master se concilia con GET /balance de la wallet (AD5). Además se
# concilia una vez al vencer el plazo del reporte de cada ciclo.
WALLET_RECONCILE_INTERVAL_SECONDS=180

# --- Reconexión del connector ---
RECONNECT_INITIAL_DELAY_SECONDS=1
RECONNECT_MAX_DELAY_SECONDS=60

# --- Healthcheck file-based del connector ---
# Prefijo: cada consumidor escribe {HEARTBEAT_PATH}.{observer|ciudad|mercado}, y el contenedor
# está healthy sólo si todos los que deberían correr latieron hace menos de MAX_AGE segundos.
HEARTBEAT_PATH=/tmp/connector-heartbeat
HEARTBEAT_MAX_AGE_SECONDS=120

# --- New Relic APM en master (RNF05) ---
# Vacía en local: master corre sin agente. En producción, la license key de la cuenta del grupo.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=EnergyShark E1
# El agente escribe su propio log en la salida del contenedor, junto al de la aplicación.
NEW_RELIC_LOG=stderr
